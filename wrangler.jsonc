{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "receipt-splitter",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "durable_objects": {
    "bindings": [
      { "name": "SplitServer", "class_name": "SplitServer" },
      { "name": "CreateLimiter", "class_name": "CreateLimiter" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SplitServer", "CreateLimiter"] }],
  "vars": { "TURNSTILE_SECRET_KEY": "1x0000000000000000000000000000000AA" },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/parties/*", "/api/*"]
  }
}
