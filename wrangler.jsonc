{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "receipt-splitter",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/parties/*", "/api/*"]
  }
}
