{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "app",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "durable_objects": {
    "bindings": [
      { "name": "SplitServer", "class_name": "SplitServer" },
      { "name": "CreateLimiter", "class_name": "CreateLimiter" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SplitServer", "CreateLimiter"] }],
  // Every scan setting lives here (preferences 57). The three limits await the operator's OK. OPENROUTER_API_KEY is a secret.
  "vars": {
    "SCAN_PER_MINUTE": "6",
    "SCAN_PER_DAY": "30",
    "SCAN_DAILY_CAP": "2000",
    "SCAN_PASS1_MODEL": "z-ai/glm-5.3-flash",
    "SCAN_PASS1_HOSTS": "parasail,baseten",
    "SCAN_PASS1_EFFORT": "minimal",
    "SCAN_PASS1_TIMEOUT_MS": "25000",
    "SCAN_PASS2_MODEL": "openai/gpt-6-luna",
    "SCAN_PASS2_HOSTS": "azure,openai",
    "SCAN_PASS2_EFFORT": "low",
    "SCAN_PASS2_TIMEOUT_MS": "30000"
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/parties/*", "/api/*"]
  }
}
